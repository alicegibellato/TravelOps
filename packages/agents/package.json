{
  "name": "@travelops/agents",
  "version": "0.1.0",
  "private": true,
  "description": "Agenti di TravelOps: interfaccia neutra verso il modello, client OpenAI, client finto con conversazioni registrate, ciclo degli strumenti e funzionamento senza chiave (REQ-ORCH-001).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prebuild": "npm run build --workspace @travelops/engine --workspace @travelops/sources",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@travelops/engine": "0.1.0",
    "@travelops/sources": "0.1.0",
    "openai": "^7.31.0"
  }
}
