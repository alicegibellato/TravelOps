{
  "name": "@travelops/engine",
  "version": "0.1.0",
  "private": true,
  "description": "Motore deterministico di TravelOps: modello dell'itinerario, fattibilità, impatto degli imprevisti, ripianificazione e versioni.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./data/reference/*": "./data/reference/*"
  },
  "files": [
    "dist",
    "data"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "demo": "tsx src/demo/main.ts"
  }
}
