{
  "name": "@travelops/sources",
  "version": "0.1.0",
  "private": true,
  "description": "Sorgenti delle destinazioni di TravelOps: formato e lettura validata delle istantanee del catalogo, controllo dei minimi e sorgente registrata (REQ-CAT-002).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pacchetto": {
      "types": "./dist/pacchetto.d.ts",
      "import": "./dist/pacchetto.js"
    },
    "./snapshots/*": "./snapshots/*"
  },
  "files": [
    "dist",
    "snapshots"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "istantanee": "tsx scripts/costruisci-precaricate.ts"
  },
  "dependencies": {
    "@travelops/engine": "0.1.0"
  }
}
