      "environment": [
        "local"
      ],
      "integrations": [],
      "nfrs": [],
      "non_goals": [
        "Prenotazioni, pagamenti, modifiche o cancellazioni presso fornitori.",
        "Apertura automatica dei link delle alternative."
      ],
      "objective": "Modifica di REQ-WEB-002: vista proposta chiara con livello di ripianificazione e modifiche evidenziate, cronologia delle versioni, la pagina Demo diventa Modalità presentazione, stato salvato nel database.",
      "release_target": null,
      "requirement_constraints": [
        "Nessuna logica del motore duplicata nella web app: proposte, controlli e versioni vengono dal motore.",
        "Testi in italiano e in linguaggio semplice; nessun codice tecnico a vista per il viaggiatore.",
        "I link delle alternative si aprono solo su clic del viaggiatore, in una nuova scheda."
      ],
