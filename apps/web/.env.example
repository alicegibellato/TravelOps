# Servizi esterni di TravelOps (REQ-INTEG-001). Copia in .env.local (stessa cartella) per usarli.
# Nessuna chiave è richiesta. Se una variabile manca o non è valida, vale il predefinito indicato.

# Modalità di ciascun servizio: "finto" (predefinito, nessuna rete) oppure "reale".
TRAVELOPS_METEO=finto        # reale = Open-Meteo (API pubblica, senza chiave)
TRAVELOPS_PERCORSI=finto     # reale = OSRM
TRAVELOPS_GEOCODING=finto    # reale = Nominatim e fonti delle destinazioni; se manca segue TRAVELOPS_PERCORSI
TRAVELOPS_VOLI=finto         # reale = fornitore di orari da collegare (oggi: solo link di ricerca)
TRAVELOPS_EVENTI=finto       # reale = fornitore di eventi da collegare (oggi: nessuno)

# Tempo massimo di una chiamata verso un servizio, in millisecondi (predefinito 8000).
# TRAVELOPS_SERVIZI_TIMEOUT_MS=8000

# Validità della cache in memoria, in secondi; 0 la disattiva.
# TRAVELOPS_METEO_TTL_S=3600
# TRAVELOPS_PERCORSI_TTL_S=86400
# TRAVELOPS_GEOCODING_TTL_S=86400
# TRAVELOPS_VOLI_TTL_S=900
# TRAVELOPS_EVENTI_TTL_S=3600

# Indirizzi dei servizi, se se ne usa uno proprio o un'istanza locale.
# TRAVELOPS_METEO_URL=https://api.open-meteo.com/v1/forecast
# TRAVELOPS_OSRM_AUTO_URL=https://router.project-osrm.org/table/v1/driving/
# TRAVELOPS_OSRM_PIEDI_URL=https://routing.openstreetmap.de/routed-foot/table/v1/driving/

# User-Agent verso Nominatim e OSRM: deve contenere "TravelOps" (predefinito TravelOps/0.1).
# TRAVELOPS_USER_AGENT=TravelOps/0.1

# Prova opzionale verso Open-Meteo reale (solo a mano): TRAVELOPS_TEST_RETE=1 npm test -w @travelops/sources

# Report dei test mostrato in /qualita (REQ-OBS-001). Predefinito: reports/test-report.json nella radice del repository.
# TRAVELOPS_RAPPORTO_TEST=/percorso/assoluto/test-report.json
# TRAVELOPS_FUSO_ORARIO=Europe/Rome

# Orologio dei viaggi (REQ-UX-003, CA-3: src/oggi/orologio.ts). I viaggi della modalità presentazione seguono sempre
# l'orologio simulato della pagina Demo; gli altri viaggi usano lo stesso giorno del viaggio e la stessa ora di
# quell'orologio (simulato relativo all'inizio del viaggio). Un viaggio creato dal viaggiatore usa l'ora reale:
#   automatico (predefinito) = quando oggi cade nelle date del viaggio; reale = sempre; simulato = mai.
# I viaggi demo restano sempre simulati. L'ora reale è nel fuso TRAVELOPS_FUSO_ORARIO (predefinito Europe/Rome).
# TRAVELOPS_OROLOGIO=automatico
